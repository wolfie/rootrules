# Copy to .env (git-ignored) and fill in. Real environment variables and command-line flags
# take precedence over this file. Remove a line or comment it out to use the default.

# LM Studio (OpenAI-compatible API). Token only if "Require Authentication" is on.
LMSTUDIO_URL=http://localhost:1234/v1
LM_API_TOKEN=
# CHAT_MODEL=qwen/qwen3-30b-a3b-2507

# rootrules server
ROOTRULES_MCP_URL=http://localhost:8787/mcp
# ROOTRULES_TOKEN=

# Local listener; set to empty (CHAT_LISTEN=) to serve only on the tailnet.
CHAT_LISTEN=127.0.0.1:8090

# Tailscale: set a device name to join your tailnet.
# TS_HOSTNAME=rootrules
# TS_AUTHKEY=tskey-auth-...   # optional; otherwise the first run prints a login URL
# TS_HTTPS=true
# TS_DIR=/path/to/state

# CHAT_MAX_STEPS=8
